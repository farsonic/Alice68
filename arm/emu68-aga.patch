+static inline uint64_t psb_now(void) { uint64_t t; __asm__ volatile("mrs %0, CNTVCT_EL0" : "=r"(t)); return t; }
+static inline unsigned psb_core(void) { uint64_t m; __asm__ volatile("mrs %0, MPIDR_EL1" : "=r"(m)); return (unsigned)(m & 3); }
+/* The lock, and the reset line while it waits: every 1024 turns, so a core
+   stuck behind a wedged holder still answers Ctrl-Amiga-Amiga. */
+static inline __attribute__((always_inline)) void ps_bus_take(void)
+{
+    if (likely(!__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE))) return;
+    unsigned n = 0;
+    uint64_t since = 0;
+    do {
+        __asm__ volatile("yield");
+#ifdef AGA_PISTORM
+        if (unlikely(!(++n & 1023))) {
+            uint32_t lev = *(gpio + 13);
+            if (!since) since = psb_now();
+            if (unlikely(!(lev & LE32(1 << PIN_RESET)))) {
+                extern void ps_wedge_reset_since(int where, uint64_t since);
+                ps_wedge_reset_since(2, since);
+            }
+        }
+#else
+        (void)n; (void)since;
+#endif
+    } while (__atomic_test_and_set(&ps_bus_lock, __ATOMIC_ACQUIRE));
+}
+static inline __attribute__((always_inline)) void ps_bus_mark(void)
+{
+    ps_bus_owner = psb_core() + 1;
+    ps_bus_ra = (uintptr_t)__builtin_return_address(0);
+}
+/* Not static: GetIPLLevel in ExecutionLoop.c drives the same GPIO pins and
+   must hold the same lock. Without the write buffer it held none, and one
+   status read colliding with a core-3 audio write was enough to wedge the
+   CPLD: every bus read returned $FF/$00 from then on, so the CIA could not
+   be acknowledged and the sandbox lost keyboard, timers and, at boot, the
+   machine. The wrappers below inline the lock (bus_acquire_in), so the
+   holder's return address is their caller's. */
+#if defined(AGA_PISTORM) && defined(AGA_PROBES)
+/* AGA-PISTORM test kernels: who waits for the bus and who holds it, per core
+   (0 = the 68k, 2 = the housekeeper and its audio-ring writes, 3 = the
+   chipset). Each core only adds to its own slots, inside the lock; the
+   chipset core reads them once a frame (aga_glue.c, bus_* counters). Asked
+   for by the PiStorm16's choke: the chipset keeps time there, so the 68k is
+   the suspect, and on that board every CIA access it makes crosses the bus. */
+volatile uint64_t ps_bus_wait_ticks[4], ps_bus_hold_ticks[4], ps_bus_wait_max[4];
+volatile uint32_t ps_bus_count[4];
+static uint64_t ps_bus_hold_t0[4];
+static inline __attribute__((always_inline)) void bus_acquire_in(void)
+{
+    uint64_t t0 = psb_now();
+    ps_bus_take();
+    ps_bus_mark();
+    uint64_t t1 = psb_now(), w = t1 - t0;
+    unsigned c = psb_core();
+    ps_bus_wait_ticks[c] += w;
+    if (w > ps_bus_wait_max[c]) ps_bus_wait_max[c] = w;
+    ps_bus_count[c]++;
+    ps_bus_hold_t0[c] = t1;
+}
+static inline __attribute__((always_inline)) void bus_release_in(void)
+{
+    unsigned c = psb_core();
+    ps_bus_hold_ticks[c] += psb_now() - ps_bus_hold_t0[c];
+    ps_bus_owner = 0;
+    __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE);
+}
+#else
+static inline __attribute__((always_inline)) void bus_acquire_in(void) { ps_bus_take(); ps_bus_mark(); }
+static inline __attribute__((always_inline)) void bus_release_in(void) { ps_bus_owner = 0; __atomic_clear(&ps_bus_lock, __ATOMIC_RELEASE); }
+#endif
+void ps_bus_acquire(void) { bus_acquire_in(); }
+void ps_bus_release(void) { bus_release_in(); }
+unsigned int ps_read_8(unsigned int address) { bus_acquire_in(); unsigned int r = ps_read_8_nolock(address); bus_release_in(); return r; }
+unsigned int ps_read_16(unsigned int address) { bus_acquire_in(); unsigned int r = ps_read_16_nolock(address); bus_release_in(); return r; }
+unsigned int ps_read_32(unsigned int address) { bus_acquire_in(); unsigned int r = ps_read_32_nolock(address); bus_release_in(); return r; }
+uint64_t ps_read_64(unsigned int address) { bus_acquire_in(); uint64_t r = ps_read_64_nolock(address); bus_release_in(); return r; }
+uint128_t ps_read_128(unsigned int address) { bus_acquire_in(); uint128_t r = ps_read_128_nolock(address); bus_release_in(); return r; }
+void ps_write_8(unsigned int address, unsigned int data) { bus_acquire_in(); ps_write_8_nolock(address, data); bus_release_in(); }
+void ps_write_16(unsigned int address, unsigned int data) { bus_acquire_in(); ps_write_16_nolock(address, data); bus_release_in(); }
+void ps_write_32(unsigned int address, unsigned int data) { bus_acquire_in(); ps_write_32_nolock(address, data); bus_release_in(); }
+void ps_write_64(unsigned int address, uint64_t data) { bus_acquire_in(); ps_write_64_nolock(address, data); bus_release_in(); }
+void ps_write_128(unsigned int address, uint128_t data) { bus_acquire_in(); ps_write_128_nolock(address, data); bus_release_in(); }
+
+#ifdef AGA_PISTORM
+/* AGA-PISTORM: the reset line, seen by a core that may be stuck (see the
+   note above wait_txn in ps_protocol.c). The housekeeper takes a keyboard
+   reset within microseconds and claims it (aga_reset_claimed); if it has
+   not in 20 ms it is stuck too, and this core reboots the Pi, after the log
+   line and the kept session that tell the next boot where it was. A line
+   that comes back up first was a glitch, or a reset Emu68 drove itself
+   (ignore_reset). */
+void __attribute__((noinline, cold)) ps_wedge_reset_since(int where, uint64_t since)
+{
+    extern void aga_diag_persist(void);
+    extern void aga_diag_wedge(int where, unsigned core, unsigned owner, uintptr_t ra, uint32_t stuck_ms);
+    if (!housekeeper_enabled || ignore_reset) return;
+    uint64_t f, t0 = psb_now();
+    __asm__ volatile("mrs %0, CNTFRQ_EL0" : "=r"(f));
+    for (;;) {
+        if ((LE32(*(gpio + 13)) & (1 << PIN_RESET)) || ignore_reset) return;
+        if (aga_reset_claimed) for (;;) __asm__ volatile("yield");    /* the Pi is going down */
+        uint64_t t = psb_now();
+        if (t - t0 > f / 50) {
+            if (__atomic_exchange_n(&aga_reset_claimed, 1, __ATOMIC_ACQ_REL))
+                for (;;) __asm__ volatile("yield");
+            uint32_t ms = since ? (uint32_t)(((t - since) * 1000u) / f) : 0;
+            aga_diag_wedge(where, psb_core(), ps_bus_owner, ps_bus_ra, ms);
+            aga_diag_persist();
+            kprintf("[HKEEP] Reset seen by core %d (the housekeeper did not take it), rebooting\n", psb_core());
+            classic_pi_reset();
+        }
+        __asm__ volatile("yield");
+    }
+}
+void ps_wedge_reset(int where) { ps_wedge_reset_since(where, 0); }
+
+/* The chipset core, once a frame: catches a housekeeper stuck anywhere else */
+void ps_reset_watch(void)
+{
+    uint32_t lev = *(gpio + 13);
+    WEDGE_CHECK(lev, 3);
+}
+
+/* agaboot WEDGETEST YES, on the housekeeper (aga_audio.c): hold the bus
+   for good, so that Ctrl-Amiga-Amiga has to come through the new path */
+void ps_wedge_test(void)
+{
+    extern void aga_diag_log(const char *s);
+    bus_acquire_in();
+    aga_diag_log("[AGA] WEDGETEST: the housekeeper holds the bus for good");
+    for (;;) __asm__ volatile("yield");
+    bus_release_in();
+}
+#endif
